# Copy to apps/web/.env.local (or root .env.local). Never commit real credentials.
# The application starts completely offline with zero credentials.

# --- MCP server (apps/mcp-server) ---
MCP_HOST=127.0.0.1
MCP_PORT=3001
# Local SQLite file; created by `npm run db:init`.
DATABASE_PATH=data/local/exam-sprint.db
LOG_LEVEL=info

# --- Web app (apps/web), server-side only ---
MCP_SERVER_URL=http://127.0.0.1:3001/mcp

# --- Optional AI Orchestrator (apps/web server-side only) ---
# Default: Google Gemini OpenAI-compatible endpoint
# Place your key in apps/web/.env.local (excluded from git)
LLM_API_KEY=replace-me
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Alternatively for standard OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
